# Auto detect text files and perform LF normalization
* text=auto

# Preserve the exact bytes bound by release archives and evidence hashes.
/skills/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/benchmarks/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Benchmark source fingerprints use exact bytes on every checkout platform.
/benchmarks/profiles.json text eol=lf
/scripts/benchmark.py text eol=lf

# Reviewed example prose is hashed as LF bytes; Windows checkout must retain LF.
/examples/**/*.md text eol=lf
/examples/**/*.txt text eol=lf

# Keep frozen analysis inputs identical across checkouts for evidence hashes.
/benchmarks/analysis-depth/** text eol=lf
/benchmarks/analysis-real/** text eol=lf
/benchmarks/analysis-crosschapter/** text eol=lf

# Legacy runtime fixture is verified by byte SHA-256 during migration tests.
/tests/fixtures/schema1_runtime.py text eol=lf

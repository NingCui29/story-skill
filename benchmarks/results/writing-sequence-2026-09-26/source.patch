+        meta = {'source': source_id, 'source_sha256': source['sha256'], 'chapter': source.get('chapter'),
+                'base_sha256': source.get('base_sha256'), 'prefix': source.get('prefix', ''),
+                'created': _utc_now(), 'adopted': False}
